+    /// Shut down this handle within a positive deadline.
+    ///
+    /// Failure leaves remote cleanup unconfirmed and retains ownership for a
+    /// retry. Success clears local cleanup obligations. Borrowed handles never
+    /// delete the instance. This method never terminates the server.
+    pub async fn shutdown(
+        &mut self,
+        timeout: Duration,
+    ) -> Result<(), crate::PocketIcShutdownError> {
+        use crate::PocketIcShutdownError;
+
+        if timeout.is_zero() {
+            return Err(PocketIcShutdownError::InvalidTimeout);
+        }
+        let cleanup = async {
+            if self.owns_instance {
+                let response = self
+                    .reqwest_client
+                    .delete(self.instance_url())
+                    .send()
+                    .await?;
+                // 202 only acknowledges acceptance, not completed deletion.
+                if !matches!(response.status(), StatusCode::OK | StatusCode::NO_CONTENT) {
+                    return Err(PocketIcShutdownError::UnexpectedStatus(response.status()));
+                }
+                self.owns_instance = false;
+                self.http_gateway = None;
+            } else if let Some(info) = &self.http_gateway {
+                let url = self
+                    .server_url
+                    .join(&format!("http_gateway/{}/stop", info.instance_id))
+                    .unwrap();
+                let response = self.reqwest_client.post(url).send().await?;
+                if response.status() != StatusCode::OK {
+                    return Err(PocketIcShutdownError::UnexpectedStatus(response.status()));
+                }
+                response.json::<()>().await?;
+                self.http_gateway = None;
+            }
+            Ok(())
+        };
+        tokio::time::timeout(timeout, cleanup)
+            .await
+            .map_err(|_| PocketIcShutdownError::DeadlineExceeded(timeout))?
+    }
+
